OPENAI_API_KEY=sk-...
# Needed for BRAIN=jev and BRAIN=hybrid. Create one at https://console.typesafe.ai/
TYPESAFE_API_KEY=...

# Which games/<name>.toml to play (slither, 2048, ...).
GAME=slither

# Who plays: llm (a LangChain chat model), jev (TypeSafe's Jev), or hybrid (LLM strategy + Jev moves).
BRAIN=llm

# LLM for the setup step (always), BRAIN=llm, and the hybrid strategist. Any "provider:model" string accepted by
# langchain's init_chat_model. Must support image input and tool calls.
MODEL=openai:gpt-4.1-mini
# Optional: point at any OpenAI-compatible server instead of api.openai.com.
# MODEL_BASE_URL=http://localhost:8000/v1

# Jev model for BRAIN=jev and hybrid. Box questions (where to steer/click) need Jev 1.14 = jev-preview.
JEV_MODEL=jev-preview

PLAYER_NAME=neo
# Set to 1 to run the browser without a window.
HEADLESS=0
# Stop after this many decisions (0 = play forever).
MAX_TICKS=0
